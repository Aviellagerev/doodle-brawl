# ── Server configuration ────────────────────────────────────────────────
# Copy this file to `.env` and adjust as needed.
#
# Every value is OPTIONAL. The defaults below match local development, so the
# server runs with NO .env file at all. Set these when your infrastructure
# differs (e.g. in production, or if Redis lives on another host).
#
# To load a .env file locally:  tsx watch --env-file=.env src/index.ts
# In production, set these as real environment variables on the host/platform.

# Port the HTTP + WebSocket server listens on
PORT=300

# Network interface to bind to (0.0.0.0 = all interfaces)
HOST=0.0.0.0

# Which web origin is allowed to connect (CORS). Must match the web app's URL.
CORS_ORIGIN=http://localhost:302

# Redis connection — room state is stored here
REDIS_HOST=127.0.0.1
REDIS_PORT=700
